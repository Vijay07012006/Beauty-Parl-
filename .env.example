# ============================================
# BEAUTY PARLÉ — ENVIRONMENT TEMPLATE
# Copy this file to .env.local and fill values
# ============================================

# ---------- DATABASE ----------
# DATABASE_URL=postgresql://username:password@host:port/database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=beauty

# ---------- REDIS ----------
# REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
# JWT_SECRET=your-secret-key-min-32-characters

# ---------- ENCRYPTION ----------
# DB_ENCRYPTION_KEY=32-character-hex-key

# ---------- EMAIL (Brevo) ----------
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=your-email@gmail.com

# ---------- PAYMENT ----------
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=xxxx
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ---------- OAuth ----------
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-secret
# GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret
# FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# ---------- AI ----------
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct

# ---------- ADMIN ----------
# ADMIN_SEED_PASSWORD=Admin@123

# ---------- FRONTEND ----------
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- NODE ----------
# NODE_ENV=development
# PORT=3001

# ---------- CORS ----------
# CORS_ORIGINS=http://localhost:3000

# ---------- CRON JOBS ----------
# SUBSCRIPTION_CHECK_CRON=0 0 * * *
# BIRTHDAY_CHECK_CRON=0 8 * * *
# PRICE_DROP_CHECK_CRON=0 0 * * *
# BACK_IN_STOCK_CHECK_CRON=0 */6 * * *

# ---------- SENTRY ----------
# SENTRY_DSN=https://...

# ---------- OTHER ----------
# CORS_ALLOW_VERCEL_PREVIEWS=true
# DB_SYNCHRONIZE=false
# DB_SSL_REJECT_UNAUTHORIZED=false
