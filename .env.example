# ============================================
# BEAUTY PARLÉ — ENVIRONMENT TEMPLATE
# Copy this to .env.local and fill values
# ============================================

# ---------- DATABASE ----------
# DATABASE_URL=postgresql://username:password@host:port/database

# ---------- REDIS ----------
# REDIS_URL=redis://localhost:6379

# ---------- JWT ----------
# JWT_SECRET=your-secret-key-min-32-characters

# ---------- ENCRYPTION ----------
# DB_ENCRYPTION_KEY=32-character-hex-key

# ---------- EMAIL (Brevo) ----------
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=your-email@gmail.com

# ---------- PAYMENT ----------
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=xxxx
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ---------- OAuth ----------
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-secret
# GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret
# FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# ---------- AI ----------
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-v1-...
# HUGGINGFACE_API_KEY=hf_...

# ---------- ADMIN ----------
# ADMIN_SEED_PASSWORD=Admin@123

# ---------- FRONTEND ----------
# FRONTEND_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- NODE ----------
# NODE_ENV=development
# PORT=3001

# ---------- CORS ----------
# CORS_ORIGINS=http://localhost:3000

# ---------- TWILIO (WhatsApp) ----------
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ---------- MAPBOX (Tracking) ----------
# MAPBOX_TOKEN=pk.eyJ1Ijoi...

# ---------- SENTRY ----------
# SENTRY_DSN=https://...

# ---------- CRON JOBS ----------
# SUBSCRIPTION_CHECK_CRON=0 0 * * *
# BIRTHDAY_CHECK_CRON=0 8 * * *
# PRICE_DROP_CHECK_CRON=0 0 * * *
# BACK_IN_STOCK_CHECK_CRON=0 */6 * * *

# ---------- PHASE 8F: MARKETING & ENGAGEMENT ----------
# LOYALTY_POINTS_RATE=0.1
# LOYALTY_TIER_SILVER_THRESHOLD=0
# LOYALTY_TIER_GOLD_THRESHOLD=500
# LOYALTY_TIER_PLATINUM_THRESHOLD=1000
# FLASH_SALE_NOTIFY_EMAIL=admin@beautyparle.com
# BLOG_AUTHOR_ID=1
# REFERRAL_REWARD_POINTS=50
# REFERRED_REWARD_POINTS=50
# DRIP_WELCOME_ENABLED=true
# DRIP_ABANDONED_CART_ENABLED=true
# DRIP_POST_PURCHASE_ENABLED=true
# DRIP_WELCOME_DELAY_HOURS=2
# DRIP_ABANDONED_DELAY_HOURS=4
# SOCIAL_PROOF_ENABLED=true
# SOCIAL_PROOF_UPDATE_INTERVAL=30

# ---------- OTHER ----------
# CORS_ALLOW_VERCEL_PREVIEWS=true
# DB_SYNCHRONIZE=false
# DB_SSL_REJECT_UNAUTHORIZED=false
